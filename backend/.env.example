# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name

# ─── Databricks ───────────────────────────────────────────────────────────────
DATABRICKS_WORKSPACE=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_pat_token_here
DATABRICKS_JOB_ID=12345
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_WORKSPACE_ID=your_workspace_id
DATABRICKS_DASHBOARD_ID=your_dashboard_id

# ─── Integration Toggles ─────────────────────────────────────────────────────
# Set false once real credentials are provided above
MOCK_S3=true
MOCK_DATABRICKS=true

# ─── App ──────────────────────────────────────────────────────────────────────
# Legacy fallback – overridden by MOCK_S3 / MOCK_DATABRICKS when set
MOCK_MODE=true
FRONTEND_URL=https://fmcg-data-forge.vercel.app
